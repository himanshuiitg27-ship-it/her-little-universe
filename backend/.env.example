# Copy to .env and fill in. Never commit .env.

# --- Database (Neon PostgreSQL) ------------------------------------------
# Neon dashboard -> Connection Details -> copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- AI (Groq) ------------------------------------------------------------
# Leave GROQ_API_KEY empty and the app still works; AI features show a friendly "not set up" state.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_ENABLED=true
AI_TEMPERATURE=0.6
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# "Today" and "tonight" are computed in this timezone (IANA name).
APP_TIMEZONE=Asia/Kolkata
# Comma-separated origins allowed to call the API directly (not needed when using the Vite proxy).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
