# Optional. By default the dev server proxies /api to http://127.0.0.1:8000.
# VITE_BACKEND_URL=http://127.0.0.1:8000   # dev proxy target
# VITE_API_URL=https://your-api.example.com/api   # only if the API is hosted on another origin (production)
# NOTE: never put API keys in any VITE_* variable - they are bundled into public JavaScript.
